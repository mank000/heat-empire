# Для публичного HTTPS-запуска. До появления домена оставь пустым.
SITE_DOMAIN=
# Сгенерируй на сервере командой openssl rand -hex 32.
DJANGO_SECRET_KEY=
# Порт базового запуска на 127.0.0.1. В режиме HTTPS он не публикуется.
HEAT_PORT=8000
# Заполняются только для запуска Telegram-бота.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ACCESS_PIN=
